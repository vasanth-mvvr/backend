                                [artifactId: 'backend',
                                classifier: '',
                                file: 'backend-'+"${APP_VERSION}"+'.zip',
                                type: 'zip']

                        ] 
                    )
                }
            }
        } */
 /*        stage('Deploy'){
            when{
                expression{
                    params.deploy 
                }
